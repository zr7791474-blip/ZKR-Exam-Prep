# AI provider (all optional — the app works fully without AI)
# Supported: openai (and OpenAI-compatible endpoints), anthropic, mock
AI_PROVIDER=openai

# Use AI_API_KEY for the generic/OpenAI-compatible path, or provider-specific keys.
AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model name. Defaults: gpt-4o-mini (OpenAI) / claude-3-5-haiku-latest (Anthropic)
AI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible base URL (Groq, OpenRouter, Ollama, LM Studio, ...)
# AI_BASE_URL=https://api.openai.com/v1

AI_MAX_TOKENS=1800
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Optional genuinely-different verifier model. Without it, AI answers remain
# proposals and are excluded from objective scores. A same-model second pass is
# reported as self-consistency, never as independent verification.
# AI_VERIFIER_PROVIDER=anthropic
# AI_VERIFIER_MODEL=claude-3-5-haiku-latest
# AI_VERIFIER_API_KEY=
# AI_VERIFIER_BASE_URL=
